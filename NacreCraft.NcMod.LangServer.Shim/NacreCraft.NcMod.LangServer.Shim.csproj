<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NacreCraft.NcMod.LangServer.Shim</RootNamespace>
    <!-- the apphost of each platform looks for a dll with this very name next to itself -->
    <AssemblyName>NacreCraft.NcMod.LangServer</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
