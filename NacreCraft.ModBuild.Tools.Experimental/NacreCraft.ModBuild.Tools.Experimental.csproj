<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The experimental command line references the shipped tool project and adds commands that are
    not ready for release. Nothing here is packed or published: the point of the split is that an
    experiment can be tried, changed or deleted without touching what users install.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NacreCraft.ModBuild.Tools.Experimental</AssemblyName>
    <RootNamespace>NacreCraft.ModBuild.Tools.Experimental</RootNamespace>

    <!--
      A separate tool package with its own command name, so an experiment installs beside ncm instead of
      replacing it. The core project is bundled rather than declared as a dependency, which keeps the
      package installable before the matching core version exists on nuget.org.
    -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ncm-exp</ToolCommandName>
    <PackageId>NacreCraft.ModBuild.Tools.Experimental</PackageId>
    <Description>NacreCraft mod development tools, experimental commands</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NacreCraft.ModBuild.Tools\NacreCraft.ModBuild.Tools.csproj"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FastParser" Version="0.1.4" />
  </ItemGroup>

  <!--
    The engine must load Microsoft.Build from the local SDK or the resolvers and targets fail on a
    mismatched interface, which is why the core project deletes the NuGet copy after build. A
    project reference does not carry that target over, so the same cleanup runs here.
  -->
  <Target Name="DropMsBuildRuntime" AfterTargets="Build">
    <ItemGroup>
      <MsBuildRuntimeFile Include="$(OutputPath)Microsoft.Build*.dll;$(OutputPath)Microsoft.NET.StringTools.dll" />
    </ItemGroup>
    <Delete Files="@(MsBuildRuntimeFile)" />
  </Target>

</Project>
