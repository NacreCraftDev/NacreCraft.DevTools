{
  "$schema": "http://json.schemastore.org/template",
  "author": "NacreCraft",
  "classifications": [ "NacreCraft", "Mod", "Library" ],
  "identity": "NacreCraft.Mod.Project",
  "name": "NacreCraft Mod",
  "description": "A NacreCraft mod project; the build output is a class library with ncmod.json embedded",
  "shortName": "ncm",
  "sourceName": "NcModTemplate",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "primaryOutputs": [
    { "path": "NcModTemplate.csproj" }
  ],
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(environment != 'both' && environment != 'server')",
          "exclude": [ "ModEntry.Server.cs" ]
        },
        {
          "condition": "(environment != 'both' && environment != 'client')",
          "exclude": [ "ModEntry.Client.cs" ]
        }
      ]
    }
  ],
  "symbols": {
    "modId": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "lowerCase",
      "replaces": "__MOD_ID__"
    },
    "environment": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Which side this mod runs on; the other side will not load it",
      "choices": [
        {
          "choice": "both",
          "description": "Load on both client and server"
        },
        {
          "choice": "server",
          "description": "Server only"
        },
        {
          "choice": "client",
          "description": "Client only"
        }
      ],
      "defaultValue": "both",
      "replaces": "__MOD_ENV__"
    }
  }
}
