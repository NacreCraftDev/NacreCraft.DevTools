<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NacreCraft mod project.
    The build output is a class library with ncmod.json embedded; drop it into the mods/ folder
    of an NC runtime directory and it loads.
    Build/kernel holds the NC assemblies shipped with the template. They are compile-time
    references only; at runtime the NC process provides them.
    Swap the whole Build/kernel folder when moving to another NC version.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Reference the NC assemblies under Build/kernel.
    The wildcard saves listing them one by one; a new kernel sub-library only means swapping
    Build/kernel.
    Private is off so they are not copied to the output directory - a mod ships only its own dll.
  -->
  <ItemGroup>
    <Reference Include="$(MSBuildThisFileDirectory)Build\kernel\*.dll" Private="false" />
  </ItemGroup>

  <!--The manifest must be embedded; the scanner only recognises the resource name ncmod.json-->
  <ItemGroup>
    <EmbeddedResource Include="ncmod.json" LogicalName="ncmod.json" />
  </ItemGroup>

  <!--The icon is embedded the same way; replace the image and keep the manifest pointing at icon.png-->
  <ItemGroup>
    <EmbeddedResource Include="icon.png" LogicalName="icon.png" />
  </ItemGroup>

  <!--
    EmbedDependencies embeds third-party dependencies into the mod dll.
    Anything added with "dotnet add package" lands in RuntimeCopyLocalItems and is embedded here
    as is. When the loader cannot resolve an assembly it falls back to the .dll resources embedded
    in the mod, so no manifest field has to be maintained.
    NC's own assemblies live in Build/kernel with Private off, so they never show up in this list.
    The .dll filter uses a transform rather than a Condition - the template engine evaluates a
    Condition containing %(...) at template time, where the metadata is unavailable, and drops
    the whole line.
  -->
  <Target Name="EmbedDependencies" AfterTargets="ResolveReferences">
    <ItemGroup>
      <NacreCraftDependency Include="@(RuntimeCopyLocalItems->WithMetadataValue('Extension', '.dll'))" />
      <EmbeddedResource Include="@(NacreCraftDependency)">
        <LogicalName>%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
    <Message Importance="normal" Text="Embedded @(NacreCraftDependency->Count()) mod dependencies" />
  </Target>

</Project>
