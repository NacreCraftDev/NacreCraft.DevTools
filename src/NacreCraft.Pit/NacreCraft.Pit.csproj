<Project Sdk="Microsoft.NET.Sdk">



  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NacreCraft.Pit</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pit</ToolCommandName>
    <PackageId>NacreCraft.Pit</PackageId>
    <Description>NacreCraft mod development helper tools</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

    <!--
      The policy checks derive from DiagnosticAnalyzer, which makes the analyzer rules apply to this assembly. They all
      assume a distributable analyzer package: this one is an internal check compiled into the tool and never shipped as
      an analyzer, so targeting the tool's own framework and skipping release tracking are both intended.
    -->
    <NoWarn>$(NoWarn);RS1036;RS1041;RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\iconttf.ttf" LogicalName="iconttf.ttf" />
  </ItemGroup>

  <!--
    The msbuild engine and the .NET sdk props and targets are bundled so package targets run on a machine without any
    sdk installed. Everything comes from the sdk this build uses, which keeps the engine, the tasks and the targets on
    one version instead of mixing a nuget copy with whatever sdk the user happens to have.
    The sdk folder is large, but the alternative is a machine without an sdk silently skipping every package target.
    The files are listed once here and copied twice: beside the built tool for development, and into the publish folder
    that dotnet pack collects a tool package from.
  -->
  <ItemGroup>
    <MsBuildBundle Include="$(MSBuildBinPath)\MSBuild.dll" />
    <MsBuildBundle Include="$(MSBuildBinPath)\Microsoft.Build.dll" />
    <MsBuildBundle Include="$(MSBuildBinPath)\Microsoft.Build.Framework.dll" />
    <MsBuildBundle Include="$(MSBuildBinPath)\Microsoft.Build.Utilities.Core.dll" />
    <MsBuildBundle Include="$(MSBuildBinPath)\Microsoft.Build.Tasks.Core.dll" />
    <MsBuildBundle Include="$(MSBuildBinPath)\Microsoft.NET.StringTools.dll" />
    <!--WriteCodeFragment turns the assembly attributes into source, and it builds that snippet through CodeDom-->
    <MsBuildBundle Include="$(MSBuildBinPath)\System.CodeDom.dll" />
    <!--Microsoft.Common.props and the language targets resolve through the extensions path, which points here-->
    <MsBuildBundle Include="$(MSBuildBinPath)\*.props" />
    <MsBuildBundle Include="$(MSBuildBinPath)\*.targets" />
    <!--the .NET sdk tasks read the nuget graph, and these sit beside the engine in an sdk install-->
    <MsBuildBundle Include="$(MSBuildBinPath)\NuGet*.dll" />
    <!--the built-in tasks are registered from these two files, which carry no extension-->
    <MsBuildBundle Include="$(MSBuildBinPath)\Microsoft.Common.tasks" />
    <MsBuildBundle Include="$(MSBuildBinPath)\Microsoft.Common.overridetasks" />
    <!--ResolveAppHosts reads the rid graph from the engine root, so a resolve without them throws-->
    <MsBuildBundle Include="$(MSBuildBinPath)\PortableRuntimeIdentifierGraph.json" />
    <MsBuildBundle Include="$(MSBuildBinPath)\RuntimeIdentifierGraph.json" />
    <MsBuildCurrentBundle Include="$(MSBuildBinPath)\Current\**\*" />
    <!--the whole Sdks folder, since the sdk targets import helpers such as SourceLink and Razor through relative paths-->
    <MsBuildSdk Include="$(MSBuildBinPath)\Sdks\**\*" />
    <!--the sdk targets reach the language targets through ../../../Roslyn, and the reference resolve walks on into
        assembly info generation, which ends in csc; the whole folder keeps that chain working-->
    <MsBuildRoslyn Include="$(MSBuildBinPath)\Roslyn\**\*" />
  </ItemGroup>

  <Target Name="BundleMsBuild" AfterTargets="Build">
    <Copy SourceFiles="@(MsBuildBundle)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MsBuildCurrentBundle)"
          DestinationFiles="@(MsBuildCurrentBundle->'$(OutputPath)Current\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MsBuildSdk)"
          DestinationFiles="@(MsBuildSdk->'$(OutputPath)Sdks\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MsBuildRoslyn)"
          DestinationFiles="@(MsBuildRoslyn->'$(OutputPath)Roslyn\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BundleMsBuildToPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(MsBuildBundle)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MsBuildCurrentBundle)"
          DestinationFiles="@(MsBuildCurrentBundle->'$(PublishDir)Current\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MsBuildSdk)"
          DestinationFiles="@(MsBuildSdk->'$(PublishDir)Sdks\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MsBuildRoslyn)"
          DestinationFiles="@(MsBuildRoslyn->'$(PublishDir)Roslyn\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Gui\ui.html" LogicalName="ui.html" />
    <EmbeddedResource Include="Gui\marked.min.js" LogicalName="marked.min.js" />
  </ItemGroup>
  <!--
    Roslynator rules ship beside the tool and are loaded only for the lint option,
    so a normal check pays nothing for them.
  -->
  <ItemGroup>
    <None Update="Analyzers\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />
    <!--
      Jint runs the experimental task scripts; the engine exposes one narrow api object and
      never AllowClr, so a script reaches only what the tool hands it.
    -->
    <PackageReference Include="Jint" Version="4.17.0" />
    <!--
      Acornima is the parser Jint uses; completion reads its syntax tree to bind a variable
      without running the script.
    -->
    <PackageReference Include="Acornima" Version="1.7.0" />
    <!--
      Microsoft.Build is compile-only and ships without its own runtime assemblies,
      because the engine must use the SDK's copy or the resolvers and targets fail on
      a mismatched interface; Targets/MsBuildLibrary.cs loads them from the SDK at runtime.
    -->
    <PackageReference Include="Microsoft.Build" Version="17.14.28" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.14.28" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <!--
      Newtonsoft is only for ncmod.json, the one json file a person writes by hand.
      Its reader keeps line and column on every token, so a bad manifest can be reported at the exact entry it broke on,
      which System.Text.Json cannot do.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.5" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!--The language server reuses the inspection code rather than keeping a second copy of it-->
    <InternalsVisibleTo Include="NacreCraft.Pit.LanguageServer" />
    <!--The experimental command line reuses dispatch and task running rather than copying them-->
    <InternalsVisibleTo Include="NacreCraft.Pit.Experimental" />
  </ItemGroup>

  <!--Pack the project template into the assembly, so init does not depend on dotnet new or a machine wide install-->
  <Target Name="PackTemplate" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_TemplateFiles Include="..\NacreCraft.ModSDK.Template\content\pit\**\*.*"
                      Exclude="..\NacreCraft.ModSDK.Template\content\pit\.template.config\**" />
    </ItemGroup>
    <RemoveDir Directories="$(BaseIntermediateOutputPath)template" />
    <Copy SourceFiles="@(_TemplateFiles)"
          DestinationFolder="$(BaseIntermediateOutputPath)template\%(RecursiveDir)" />
    <ZipDirectory SourceDirectory="$(BaseIntermediateOutputPath)template"
                  DestinationFile="$(BaseIntermediateOutputPath)pit-template.zip"
                  Overwrite="true" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="$(BaseIntermediateOutputPath)pit-template.zip" LogicalName="pit-template.zip" />
  </ItemGroup>

</Project>
