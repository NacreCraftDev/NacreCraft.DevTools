<?xml version="1.0" encoding="utf-8"?>
<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <LangVersion>latest</LangVersion>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>NacreCraft Contributors</Authors>
    <Product>NacreCraft</Product>
    <Copyright>Copyright (c) NacreCraft Contributors</Copyright>

    <!-- ncm and the project template share this version, so bump it here on release -->
    <VersionPrefix>1.9.10</VersionPrefix>
    <AssemblyVersion>1.9.10.0</AssemblyVersion>
    <FileVersion>1.9.10.0</FileVersion>
  </PropertyGroup>

</Project>
