<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This project is deliberately broken. It is the acceptance fixture for the
    compile-error advice that ncm prints, so it is never built as part of the
    product and never referenced by it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- the cases need System.Text, System.Linq and System.IO to be missing on purpose -->
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>NacreCraft.ModBuild.ToolsTest</RootNamespace>
    <AssemblyName>NacreCraft.ModBuild.ToolsTest</AssemblyName>
  </PropertyGroup>

</Project>
